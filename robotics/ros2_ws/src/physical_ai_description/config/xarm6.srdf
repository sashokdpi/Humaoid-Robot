<?xml version="1.0"?>
<!-- Matches xarm_moveit_config group name -->
<robot name="xarm6">
  <group name="xarm6">
    <joint name="joint1"/>
    <joint name="joint2"/>
    <joint name="joint3"/>
    <joint name="joint4"/>
    <joint name="joint5"/>
    <joint name="joint6"/>
  </group>
  <end_effector name="link_eef" parent_link="link_eef" group="xarm6"/>
  <group name="xarm_gripper">
    <joint name="drive_joint"/>
  </group>
  <disable_collisions link1="link_base" link2="link1" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
  <disable_collisions link1="link5" link2="link6" reason="Adjacent"/>
</robot>
