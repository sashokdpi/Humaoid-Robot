# Copy to config/jetson.env and set your xArm6 IP
# source config/jetson.env

export XARM_IP=192.168.1.206
export PHYSICAL_AI_MODE=hardware
export PHYSICAL_AI_PERCEPTION=ros2
export PHYSICAL_AI_ROBOT_BACKEND=ros2
export PHYSICAL_AI_GRIPPER=1
export PHYSICAL_AI_GRIPPER_TYPE=ufactory_standard
export PHYSICAL_AI_ADD_GRIPPER=true
export PHYSICAL_AI_YOLO_DEVICE=cuda:0
export PHYSICAL_AI_ROOT=/home/ubuntu/physical_ai_system
export XARM_WS=/home/ubuntu/xarm_ws
