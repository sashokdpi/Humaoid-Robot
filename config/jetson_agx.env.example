# Jetson AGX Orin — Physical AI + xArm6 (copy to config/jetson.env)
# source ~/physical_ai_system/config/jetson.env

# --- Network ---
export XARM_IP=192.168.1.206
export JETSON_POWER_MODE=0   # 0 = MAXN on Orin AGX (sudo nvpmodel -m 0)

# --- Paths ---
export PHYSICAL_AI_ROOT=/home/ubuntu/physical_ai_system
export XARM_WS=/home/ubuntu/xarm_ws

# --- Hardware mode ---
export PHYSICAL_AI_MODE=hardware
export PHYSICAL_AI_PERCEPTION=ros2
export PHYSICAL_AI_ROBOT_BACKEND=ros2
export PHYSICAL_AI_ROBOT=xarm6
export PHYSICAL_AI_GRIPPER=1
export PHYSICAL_AI_GRIPPER_TYPE=ufactory_standard
export PHYSICAL_AI_ADD_GRIPPER=true

# --- NVIDIA / CUDA (AGX has headroom for GPU inference) ---
export PHYSICAL_AI_YOLO_DEVICE=cuda:0
export PHYSICAL_AI_TRAIN_DEVICE=cuda:0
export CUDA_VISIBLE_DEVICES=0

# --- xArm6 ROS2 (Humble) ---
export PHYSICAL_AI_JOINT_NAMES=joint1,joint2,joint3,joint4,joint5,joint6
export PHYSICAL_AI_TRAJECTORY_ACTION=/xarm6_traj_controller/follow_joint_trajectory
export PHYSICAL_AI_MOVE_GROUP=xarm6
export PHYSICAL_AI_PLANNING_FRAME=link_base
export PHYSICAL_AI_EE_LINK=link_eef
export PHYSICAL_AI_GRIPPER_ACTION=/xarm_gripper/gripper_action

# --- Optional: local LLM on AGX (Ollama + Phi) ---
# export PHYSICAL_AI_LLM_PROVIDER=ollama
# export PHYSICAL_AI_LLM_MODEL=phi4
# export PHYSICAL_AI_LLM_BASE_URL=http://127.0.0.1:11434/v1
